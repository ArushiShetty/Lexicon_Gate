    "notes": "optional labeling notes"
  },
  "how_to_label": [
    "Upload papers in the Library UI (or ingest into the same backend data dir).",
    "From the repo root: python eval/run_eval.py --dump-chunks",
    "Open eval/output/index_chunks.csv and copy real chunk_id values into relevant_chunk_ids.",
    "Write expected_facts from the paper text, not from a model answer.",
    "Set labeling_status to labeled when at least some rows have query + gold fields.",
    "Run: python eval/run_eval.py"
  ],
